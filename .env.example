# AutoDS Copilot — optional LLM configuration.
# Copy this file to .env and fill in ONE provider. The real .env is gitignored,
# so keys never get committed. With nothing set, the copilot runs fully offline
# on rule-based text.

# Which provider to use: auto | openai | anthropic | ollama | none
# "auto" picks whichever key below is present, then a local Ollama if running.
AUTODS_LLM_PROVIDER=auto

# Optional model override. Leave blank to use a sensible per-provider default
# (openai gpt-4o-mini, anthropic claude-3-5-haiku-latest, ollama llama3.1).
AUTODS_LLM_MODEL=

# Generation settings (optional).
AUTODS_LLM_TEMPERATURE=0.2
AUTODS_LLM_MAX_TOKENS=700

# --- Provider credentials (set the one you use) ------------------------------
# OpenAI or any OpenAI-compatible endpoint
OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Anthropic Claude
ANTHROPIC_API_KEY=

# Ollama (local, no key). Only the host is needed, and only if not the default.
OLLAMA_HOST=http://localhost:11434
